# Maintainer: Frank <frank@swangui.invalid>
pkgname=swangui
pkgver=1.0.8
pkgrel=1
pkgdesc="FortiClient-style IPsec VPN client for strongSwan, with tray icon"
arch=('any')
url="https://github.com/FrankMncrf/SwanGUI"
license=('GPL-3.0-or-later')
depends=('python' 'python-pyqt6' 'strongswan' 'polkit' 'nftables' 'iproute2' 'systemd' 'openssl' 'iputils'
         'python-cryptography' 'libsecret' 'networkmanager' 'polkit-gnome')
checkdepends=('python-cryptography')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('41ec56cd80f44aae8afda273bc5e69d06e31624c440fc965501cb4ec60a53f83')

check() {
    cd "SwanGUI-$pkgver"
    QT_QPA_PLATFORM=offscreen make test
}

package() {
    cd "SwanGUI-$pkgver"
    make install DESTDIR="$pkgdir" PREFIX=/usr
}
